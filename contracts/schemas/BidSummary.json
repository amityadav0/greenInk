{
  "$defs": {
    "TenderSource": {
      "description": "Where a tender came from. One value per `sources` adapter.",
      "enum": [
        "gem",
        "upload"
      ],
      "title": "TenderSource",
      "type": "string"
    },
    "TriageBadge": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "$ref": "#/$defs/TriageLevel"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "level",
        "reason"
      ],
      "title": "TriageBadge",
      "type": "object"
    },
    "TriageLevel": {
      "description": "Win-ability badge on a search result.",
      "enum": [
        "green",
        "amber",
        "red"
      ],
      "title": "TriageLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A search result. Search stores tender metadata, so every result has a `tender_id`.",
  "properties": {
    "badge": {
      "anyOf": [
        {
          "$ref": "#/$defs/TriageBadge"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Null until triage scores it."
    },
    "buyer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Buyer"
    },
    "closes_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Closes At"
    },
    "official_url": {
      "anyOf": [
        {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Official Url"
    },
    "quantity": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quantity"
    },
    "source": {
      "$ref": "#/$defs/TenderSource"
    },
    "source_ref": {
      "title": "Source Ref",
      "type": "string"
    },
    "tender_id": {
      "format": "uuid",
      "title": "Tender Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "value_inr": {
      "anyOf": [
        {
          "description": "Amount in Indian rupees.",
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Value Inr"
    }
  },
  "required": [
    "tender_id",
    "source",
    "source_ref",
    "title"
  ],
  "title": "BidSummary",
  "type": "object"
}
