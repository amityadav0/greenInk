# Copy to .env and fill in. Never commit .env.
# docker compose overrides DATABASE_URL, REDIS_URL and R2_* with its own local services.

# Nebius Token Factory (every LLM call). https://tokenfactory.nebius.com
NEBIUS_API_KEY=
# Tavily (price intel, company from URL). https://tavily.com
TAVILY_API_KEY=

# Local defaults match docker-compose; production points at Neon / Upstash / R2.
DATABASE_URL=postgresql+psycopg://greenink:greenink@localhost:5433/greenink
REDIS_URL=redis://localhost:6380/0

# Blob storage (S3 API): MinIO locally, Cloudflare R2 in production.
R2_ENDPOINT_URL=http://localhost:9000
R2_ACCESS_KEY_ID=greenink-local
R2_SECRET_ACCESS_KEY=greenink-local-only
R2_BUCKET=greenink

# Signs the anonymous session cookie. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

ENV=local
LOG_LEVEL=INFO
WEB_ORIGIN=http://localhost:3000
# Where the web app's /v1 proxy forwards to (server-side only).
API_URL=http://localhost:8000
